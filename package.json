{
  "name": "durable-agent-workflow-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Production-inspired durable workflow foundation; DAW-1 has no execution workers or agents",
  "type": "module",
  "engines": { "node": "24.20.0" },
  "scripts": {
    "check:node": "node scripts/check-node.mjs",
    "typecheck": "npm run check:node && tsc --noEmit",
    "build": "npm run check:node && tsc",
    "migrate": "node dist/src/entrypoints/migrate.js",
    "start": "node dist/src/entrypoints/api.js",
    "test:unit": "node --test dist/tests/unit.test.js",
    "test:integration": "node --test dist/tests/integration.test.js",
    "validate": "node scripts/validate.mjs"
  },
  "dependencies": { "fastify": "5.12.3", "pg": "8.23.0" },
  "devDependencies": { "@types/node": "24.13.3", "@types/pg": "8.23.1", "typescript": "7.0.2" }
}
