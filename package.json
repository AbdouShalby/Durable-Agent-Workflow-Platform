{
  "name": "durable-agent-workflow-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Production-inspired durable workflow execution and external-effect reconciliation lab; no agents",
  "type": "module",
  "engines": { "node": "24.20.0" },
  "scripts": {
    "check:node": "node scripts/check-node.mjs",
    "typecheck": "npm run check:node && tsc --noEmit",
    "build": "npm run check:node && tsc",
    "migrate": "node dist/src/entrypoints/migrate.js",
    "start": "node dist/src/entrypoints/api.js",
    "worker": "node dist/src/entrypoints/worker.js",
    "scheduler": "node dist/src/entrypoints/scheduler.js",
    "simulator": "node dist/src/simulator/server.js",
    "test:secrets": "node --test tests/secret-guard.test.mjs && node scripts/secret-guard.mjs",
    "test:unit": "node --test dist/tests/unit.test.js dist/tests/execution-unit.test.js dist/tests/effect-unit.test.js",
    "test:integration": "node --test dist/tests/integration.test.js dist/tests/execution.test.js dist/tests/effects.test.js",
    "validate": "node scripts/validate.mjs"
  },
  "dependencies": { "fastify": "5.12.3", "pg": "8.23.0" },
  "devDependencies": { "@types/node": "24.13.3", "@types/pg": "8.23.1", "typescript": "7.0.2" }
}
